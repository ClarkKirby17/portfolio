# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. `.env.local` is gitignored: keep it that way.
#
# RULE: only VITE_-prefixed variables reach the browser. Anything without the
# prefix stays on the server. Never prefix an API key.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI assistant ─────────────────────────────────────────────────────────────
# Which provider api/chat.ts calls: "gemini" (default) or "groq".
AI_PROVIDER=gemini

# Google AI Studio. Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs change. Gemini retired the 2.0 family in June 2026 and moved the
# Pro tier to paid-only in April 2026. Check the current free-tier list at
# https://ai.google.dev/gemini-api/docs/pricing before you deploy.
GEMINI_MODEL=gemini-2.5-flash

# Groq: fallback provider, faster, open-weights: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Frontend (public. These DO ship to the browser) ─────────────────────────
# Leave unset to use the built-in /api/chat route.
# VITE_CHAT_ENDPOINT=/api/chat

# Contact form target. Any service that accepts a JSON POST works:
# Formspree, Web3Forms, or your own function. Unset = opens a prefilled email.
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
